# Railway Environment Variables for Bulletin Gestion
# Copy relevant values to Railway dashboard (Settings → Variables)

# === Base de données ===
# NE RIEN DÉFINIR manuellement : liez le plugin PostgreSQL Railway au service.
# Railway injecte automatiquement DATABASE_URL, qui est convertie en datasource JDBC
# par RailwayEnvironmentPostProcessor.
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# === Profil Spring (OBLIGATOIRE en production) ===
SPRING_PROFILES_ACTIVE=prod

# === JWT Secret (générer : openssl rand -hex 32) ===
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# === Admin init key (générer : openssl rand -hex 24) ===
ADMIN_INIT_KEY=change-me-generate-with-openssl-rand-hex-24

# === Server (Railway injecte PORT automatiquement ; 8000 par défaut) ===
SERVER_PORT=8000

# === CORS (URLs exactes du frontend, séparées par des virgules) ===
CORS_ALLOWED_ORIGINS=https://scolanote.vercel.app,https://scolanote-frontend.vercel.app

# === Frontend URL (liens dans les emails) ===
FRONTEND_URL=https://scolanote.vercel.app

# === Email (SMTP) — requis pour "mot de passe oublié" ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=noreply@bulletin.local

# === Upload (fallback local — éphémère sur Railway) ===
UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE=10MB

# === Stockage S3 pour les PDFs (RECOMMANDÉ — sinon PDFs régénérés à la demande) ===
# Compatible AWS S3, Cloudflare R2, MinIO. Laisser vide = stockage local temporaire.
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# === Logging ===
LOG_LEVEL=INFO
ROOT_LOG_LEVEL=WARN
