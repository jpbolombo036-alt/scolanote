# Database Configuration
# Sur Railway : ne rien définir, DATABASE_URL est fournie automatiquement par le plugin PostgreSQL
# En local : utilisez une URL JDBC classique
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/bulletindb
SPRING_DATASOURCE_DRIVER_CLASS=org.postgresql.Driver
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Hibernate Dialect
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Profil Spring (local | prod)
SPRING_PROFILES_ACTIVE=local

# Server Configuration
SERVER_PORT=8000

# CORS Configuration (URLs exactes du frontend, séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT Secret (REQUIRED - générer avec : openssl rand -hex 32)
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
MAIL_FROM=noreply@bulletin.local

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Admin init key (générer avec : openssl rand -hex 24)
ADMIN_INIT_KEY=change-me-generate-with-openssl-rand-hex-24

# Upload directories (fallback local si S3 non configuré)
UPLOAD_DIR=/tmp/uploads
MAX_FILE_SIZE=150MB

# Stockage S3 pour les PDFs (RECOMMANDÉ sur Railway - filesystem éphémère)
# Compatible AWS S3, Cloudflare R2, MinIO, etc.
# Laisser S3_BUCKET vide = stockage local (fichiers perdus au redémarrage sur Railway)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Logging Level
LOG_LEVEL=INFO
